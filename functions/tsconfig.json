{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "outDir": "lib",
    "rootDir": "src",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["node"],
    "noImplicitReturns": true,
    "noUnusedLocals": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib"]
}
